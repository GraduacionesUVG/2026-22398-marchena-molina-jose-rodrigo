# SmartUse: environment variables (example values only, no real credentials)
#
# The project has several components, and each one reads its configuration in a
# different place. This file lists every variable in one spot. Copy only the
# block you need to the location shown in its header.
# Real values (.env, local.properties) are git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# 1. Android apps (frontend_v1 = recolección, frontend_v2 = despliegue)
#    Option A: environment variables when running Gradle.
#    Option B (recommended): copy local.properties.example to local.properties
#              in each app and use the keys smartuse.baseUrl,
#              smartuse.contact.phone, smartuse.contact.email.
# ---------------------------------------------------------------------------
SMARTUSE_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
SMARTUSE_CONTACT_PHONE=+000 0000 0000
SMARTUSE_CONTACT_EMAIL=contact@example.com

# ---------------------------------------------------------------------------
# 2. Backend: CDK deploy and Python scripts (backend/smartUse-backend)
#    AWS credentials come from the AWS CLI profile and are NOT written here.
# ---------------------------------------------------------------------------
AWS_PROFILE=smartuse
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# 3. Grafana monitoring (backend/smartUse-backend/grafana/.env)
#    Generated automatically by grafana/setup-db-access.sh.
# ---------------------------------------------------------------------------
AURORA_HOST=<cluster-endpoint>.<region>.rds.amazonaws.com
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change_me

# ---------------------------------------------------------------------------
# 4. Lambda runtime (reference only)
#    CDK injects these on deploy. Do not set them by hand.
# ---------------------------------------------------------------------------
# CLUSTER_ARN=arn:aws:rds:<region>:<account-id>:cluster:<cluster-name>
# SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>
# DATABASE_NAME=smartuse
# RAW_BUCKET_NAME=<bucket-name>

# ---------------------------------------------------------------------------
# 5. ML pipeline figures (data_ml/smartUse-dataMining), optional
# ---------------------------------------------------------------------------
# PLOT_TITLES=1
