<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Registration (POST /users) and the cutoff (GET /cutoff) need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Runtime permission from API 33 (our minSdk), requested in the setup wizard.
      Not needed for the foreground service to run, but without it the service's
      persistent notification is hidden from the drawer (still listed in the
      system Task Manager).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- StudyService runs in the foreground from setup to the end (startForeground). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Brings the study service and the schedule back after a reboot (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets the setup wizard show the system "allow this app to ignore battery
      optimizations" dialog. Being exempt keeps the OS from demoting the idle app
      to a restrictive standby bucket, which would throttle the capture and sync
      jobs. Play Store policy restricts this permission; the APK is distributed
      manually, so that does not apply.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Special "appop" permission: it is never granted at install time. Declaring
      it is what makes the app appear in Settings > Apps > Special app access >
      Usage access, where the participant toggles it on during setup. Lint flags
      the declaration itself (ProtectedPermissions) — that is expected here.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Display over other apps: the intervention overlay (and later the post-forms
      unlock card). Special permission: granted by the participant in setup, from
      the app's own switch in Settings.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartUsefrontend">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartUsefrontend"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the process alive from setup to the end; its notification is the
          study notification. No foregroundServiceType: targetSdk 33.
        -->
        <service
            android:name=".service.StudyService"
            android:exported="false" />

        <!--
          The one exported component besides MainActivity: a system broadcast
          needs it. It ignores every action but BOOT_COMPLETED.
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Lets the data-overview page share the participant's own raw
          capture log as a CSV via the system share sheet (transparency
          feature, not a debug tool). android:exported="false", like every
          component without external callers; the share sheet itself grants the receiving
          app temporary read access to just that one file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>